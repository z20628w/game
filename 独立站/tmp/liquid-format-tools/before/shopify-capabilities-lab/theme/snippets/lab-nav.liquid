  <div class="lab-nav-links">
    <a href="{{ routes.root_url }}#lab-catalog">能力地图</a>
    <a href="{{ routes.root_url }}?view=lab-ui">界面设计</a>
    <a href="{{ routes.collections_url }}/lab-demo-collection">商品体验</a>
    <a href="{{ routes.root_url }}?view=lab-data">自定义数据</a>
    <a href="{{ routes.root_url }}?view=lab-api">接口实验</a>
    <a href="{{ routes.root_url }}?view=lab-components">组件实验</a>
    <a href="{{ routes.root_url }}?view=lab-saved">收藏对比</a>
    <a href="{{ routes.root_url }}pages/lab-demo-contact">联系表单</a>
    <a href="{{ routes.root_url }}?view=lab-boundaries">能力边界</a>
    <a href="{{ routes.root_url }}?view=lab-markets">海外市场要求</a>
  </div>
</nav>
