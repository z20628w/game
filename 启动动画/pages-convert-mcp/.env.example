# 至少 32 字符；启动脚本可以生成。
MCP_API_KEY=
# 本地测试用此地址；接入企业微信前换成你自己的 HTTPS 地址。
PUBLIC_BASE_URL=http://127.0.0.1:8765
BIND_HOST=127.0.0.1
PORT=8765
# 留空时自动查找项目 .runtime/lo 或系统 LibreOffice。
SOFFICE_PATH=
# 只允许从下面明确列出的附件域名下载文件；默认禁用 URL 下载。
# 根据实际企业微信附件 URL 填写完整主机名，逗号分隔，不支持通配符。
SOURCE_HOSTS=
MAX_FILE_MB=30
RETENTION_HOURS=24
